# ============================================================================
# PublishOps Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# --------------------------------------------------------------------------
# General
# --------------------------------------------------------------------------
NODE_ENV=development
COMPOSE_PROJECT_NAME=publishops
TZ=UTC

# --------------------------------------------------------------------------
# PostgreSQL 16
# --------------------------------------------------------------------------
POSTGRES_USER=publishops
POSTGRES_PASSWORD=changeme_in_production_2024!
POSTGRES_DB=publishops
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://publishops:changeme_in_production_2024!@postgres:5432/publishops

# --------------------------------------------------------------------------
# Redis 7
# --------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# --------------------------------------------------------------------------
# FastAPI Backend
# --------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
SECRET_KEY=replace-with-a-64-char-random-hex-string
CORS_ORIGINS=http://localhost:3000,http://dashboard:3000
LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Next.js Dashboard
# --------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
DASHBOARD_PORT=3000

# --------------------------------------------------------------------------
# Apache Airflow
# --------------------------------------------------------------------------
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__FERNET_KEY=replace-with-fernet-key-from-python-cryptography
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://publishops:changeme_in_production_2024!@postgres:5432/airflow
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://publishops:changeme_in_production_2024!@postgres:5432/airflow
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/1
AIRFLOW__WEBSERVER__SECRET_KEY=replace-with-a-webserver-secret-key
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=false
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth
AIRFLOW__SCHEDULER__DAG_DIR_LIST_INTERVAL=30
AIRFLOW__LOGGING__BASE_LOG_FOLDER=/opt/airflow/logs
AIRFLOW__LOGGING__REMOTE_LOGGING=false
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@publishops.io

# Connection to FastAPI backend (used by DAGs)
AIRFLOW_VAR_BACKEND_URL=http://backend:8000
AIRFLOW_VAR_BACKEND_API_KEY=internal-api-key-replace-me

# --------------------------------------------------------------------------
# AI / LLM API Keys
# --------------------------------------------------------------------------
# OpenAI — used for content generation fallback
# OPENAI_API_KEY=sk-...

# Anthropic Claude — primary content engine (Claude 3.5 Sonnet recommended)
# ANTHROPIC_API_KEY=sk-ant-...

# ElevenLabs — text-to-speech for voiceovers
# ELEVENLABS_API_KEY=...

# Runway ML — AI video generation
# RUNWAY_API_KEY=...

# --------------------------------------------------------------------------
# Social Platform API Keys
# --------------------------------------------------------------------------
# YouTube Data API v3 + OAuth 2.0
# YOUTUBE_CLIENT_ID=...
# YOUTUBE_CLIENT_SECRET=...
# YOUTUBE_REFRESH_TOKEN=...

# TikTok Content Posting API
# TIKTOK_CLIENT_KEY=...
# TIKTOK_CLIENT_SECRET=...
# TIKTOK_ACCESS_TOKEN=...

# Instagram Graph API (via Meta Business Suite)
# INSTAGRAM_APP_ID=...
# INSTAGRAM_APP_SECRET=...
# INSTAGRAM_ACCESS_TOKEN=...
# INSTAGRAM_BUSINESS_ACCOUNT_ID=...

# Twitter/X API v2
# TWITTER_API_KEY=...
# TWITTER_API_SECRET=...
# TWITTER_ACCESS_TOKEN=...
# TWITTER_ACCESS_TOKEN_SECRET=...
# TWITTER_BEARER_TOKEN=...

# LinkedIn Marketing API
# LINKEDIN_CLIENT_ID=...
# LINKEDIN_CLIENT_SECRET=...
# LINKEDIN_ACCESS_TOKEN=...
# LINKEDIN_ORGANIZATION_ID=...

# --------------------------------------------------------------------------
# AWS Credentials (for S3, Lambda, etc.)
# --------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
AWS_S3_BUCKET=publishops-media

# --------------------------------------------------------------------------
# Monitoring / Alerting
# --------------------------------------------------------------------------
# Sentry DSN for error tracking
# SENTRY_DSN=https://...@sentry.io/...

# Slack webhook for pipeline alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --------------------------------------------------------------------------
# BullMQ Worker Settings
# --------------------------------------------------------------------------
UPLOAD_WORKER_CONCURRENCY=3
COMMENT_WORKER_CONCURRENCY=5
EDIT_WORKER_CONCURRENCY=2
WORKER_LOG_LEVEL=info
