# =============================================================================
# PublishOps — Airflow Dockerfile
# =============================================================================
# Extends the official Airflow image with project-specific dependencies and DAGs.
# =============================================================================

FROM apache/airflow:2.9.3-python3.12

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Install additional Python packages needed by DAGs
COPY airflow/requirements.txt /tmp/airflow-requirements.txt
RUN pip install --no-cache-dir -r /tmp/airflow-requirements.txt \
    && rm /tmp/airflow-requirements.txt

# Copy DAGs and plugins into the image (for production)
# In dev, these are mounted as volumes via docker-compose
COPY --chown=airflow:root airflow/dags/ /opt/airflow/dags/
COPY --chown=airflow:root airflow/plugins/ /opt/airflow/plugins/
